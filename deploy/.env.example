# Copy to deploy/.env and fill locally. Never commit real values.

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=newapi
MYSQL_USER=newapi
MYSQL_PASSWORD=

REDIS_PASSWORD=

SESSION_SECRET=
CRYPTO_SECRET=

TZ=Asia/Shanghai
SQL_DSN=
REDIS_CONN_STRING=

IMAGE_NAME=ai-platform-newapi
IMAGE_TAG=

DATA_ROOT=/opt/ai-platform/data
LOG_ROOT=/opt/ai-platform/logs

# Leave empty until the official domain exists. Same-origin console does not need cookies over CORS.
CORS_ALLOW_ORIGINS=

# Set both only after HTTPS on the official domain.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_TRUSTED_URL=

# Reverse proxy on the Docker frontend network. Do not publish :3000 publicly.
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

# PENDING_CONFIGURATION — do not put provider keys or payment secrets here.
# OpenAI / Anthropic / Gemini keys: Admin → Channels
# Alipay Open Platform: ALIPAY_APP_ID plus key files under /opt/ai-platform/secrets/alipay/
#   ALIPAY_PUBLIC_KEY_FILE must be the 支付宝公钥 from the console, not the 应用公钥.
# EPay URL / PID / KEY: Admin → Payment settings (unused when Alipay direct is configured)
# Turnstile: Admin → Auth
# Product name / logo: Admin → Site (SystemName / Logo)

ALIPAY_APP_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# Wallet / top-up async callback only
ALIPAY_NOTIFY_URL=
# ChatGPT Business Seat async callback only
ALIPAY_BUSINESS_SEAT_NOTIFY_URL=
