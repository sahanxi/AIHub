# Copy to deploy/.env and fill locally. Never commit real values.

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=newapi
MYSQL_USER=newapi
MYSQL_PASSWORD=

REDIS_PASSWORD=

SESSION_SECRET=
CRYPTO_SECRET=

TZ=Asia/Shanghai
SQL_DSN=
REDIS_CONN_STRING=

IMAGE_NAME=ai-platform-newapi
IMAGE_TAG=

DATA_ROOT=/opt/ai-platform/data
LOG_ROOT=/opt/ai-platform/logs

# Leave empty until the official domain exists. Same-origin console does not need cookies over CORS.
CORS_ALLOW_ORIGINS=

# Set both only after HTTPS on the official domain.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_TRUSTED_URL=

# Reverse proxy on the Docker frontend network. Do not publish :3000 publicly.
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

# PENDING_CONFIGURATION — do not put provider keys or EPay KEY here.
# OpenAI / Anthropic / Gemini keys: Admin → Channels
# EPay URL / PID / KEY: Admin → Payment settings
# Turnstile: Admin → Auth
# Product name / logo: Admin → Site (SystemName / Logo)
